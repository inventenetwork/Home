# Copy to .env and edit. Never commit .env.

NODE_ENV=development
PORT=3000

# Leave DATABASE_URL empty in development to use an embedded Postgres (PGlite) stored in PGLITE_DIR.
# In production set a real Postgres URL, e.g. postgres://user:pass@localhost:5432/home360
DATABASE_URL=
PGLITE_DIR=./data/pglite

# REQUIRED. At least 32 random characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
OTP_SECRET=

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173

# Email (OTP). If SMTP_HOST is empty, codes are printed to the server console (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Home360 <no-reply@example.com>

# Development only: also print login codes in the server console when SMTP_HOST is set (refused in production).
DEV_LOG_OTP=false

# Google sign-in (optional). Create an OAuth client of type "Web application" in Google Cloud Console and paste its client id here.
# Authorised JavaScript origins must include http://localhost:3000 (and your real domain later). No client secret is needed.
GOOGLE_CLIENT_ID=

# Encrypts providers' bank account numbers. Required in production; at least 32 random characters. Back it up:
# losing it makes saved bank details unreadable. (Development falls back to JWT_SECRET.)
DATA_KEY=
# Where provider ID documents and job photos are kept. Private: the web server never serves this folder directly.
UPLOAD_DIR=./data/uploads

# Payments. Only the pretend gateway exists so far (no real money moves). Production refuses to start with it.
PAYMENT_GATEWAY=fake

# Shown on the Terms and Privacy pages. Use your registered company name (and SSM number in the page text) before launch.
COMPANY_NAME=Home360 (company name to be added)
SUPPORT_EMAIL=support@example.com

# First admin account created by `npm run db:seed`
ADMIN_EMAIL=

# ── Hosting without a permanent disk (Vercel) ──
# Photos and ID documents go to a PRIVATE S3-compatible bucket instead of ./data/uploads. Required on Vercel.
STORAGE=disk
S3_BUCKET=
S3_REGION=ap-southeast-1
# Only for non-AWS services such as Cloudflare R2, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=uploads/

# Lets Vercel Cron call /internal/housekeeping (releases unpaid slots, closes old job offers). At least 16 random characters.
CRON_SECRET=

# Production refuses the pretend payment gateway. Set to true ONLY for an online demo with no real money.
ALLOW_FAKE_PAYMENTS=false

# Database connections per running instance. Keep small on serverless hosts.
DB_POOL_MAX=5

# Online demo only: log in with username + password (admin / vendor / user) instead of an emailed code. No SMTP needed.
# In production it also requires ALLOW_FAKE_PAYMENTS=true. Never use with real customers.
DEMO_MODE=false
DEMO_PASSWORD=demo1234
# STORAGE=db keeps uploads inside the database (DEMO_MODE demos only, e.g. Vercel without a bucket).
